<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f7f8ee">
  <meta name="description" content="Shop fresh, delicious and affordable fruits at Rita Fruit Shop. Browse seasonal favourites, find a deal and fill your basket.">
  <title>Rita Fruit Shop | Fresh fruit, happy days</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --green: #245c35;
      --green-dark: #193f27;
      --green-bright: #79a94b;
      --lime: #eaf0d9;
      --orange: #f28a39;
      --yellow: #f6ca52;
      --cream: #f7f8ee;
      --paper: #fffefa;
      --ink: #25332a;
      --muted: #788177;
      --line: #e9ebdf;
      --shadow: 0 16px 46px rgba(37, 51, 42, .09);
      --radius: 22px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body { margin: 0; color: var(--ink); background: var(--paper); font-family: "DM Sans", sans-serif; }
    button, input, textarea { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }
    .container { width: min(1160px, calc(100% - 44px)); margin-inline: auto; }
    .eyebrow { color: var(--green-bright); font-size: .75rem; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
    .section-heading { max-width: 600px; margin: 0 auto 38px; text-align: center; }
    .section-heading h2 { margin: 10px 0 12px; font: 800 clamp(2rem, 4vw, 3rem)/1.08 "Nunito", sans-serif; letter-spacing: -.045em; }
    .section-heading p { max-width: 490px; margin: 0 auto; color: var(--muted); line-height: 1.7; }
    .btn { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 9px; padding: 0 21px; border: 0; border-radius: 999px; background: var(--green); color: white; font-weight: 700; cursor: pointer; transition: transform .18s ease, background .18s ease, box-shadow .18s ease; }
    .btn:hover { transform: translateY(-2px); background: var(--green-dark); box-shadow: 0 9px 20px rgba(36, 92, 53, .2); }
    .btn-orange { background: var(--orange); color: #281c11; }
    .btn-orange:hover { background: #e97828; }
    .btn-outline { border: 1px solid var(--line); background: transparent; color: var(--green); }
    .btn-outline:hover { background: var(--lime); box-shadow: none; }

    .topbar { background: var(--green-dark); color: #fff; font-size: .77rem; }
    .topbar-inner { display: flex; min-height: 37px; align-items: center; justify-content: space-between; gap: 12px; }
    .topbar strong { color: var(--yellow); }
    .topbar-note { opacity: .84; }
    .header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid rgba(37, 51, 42, .06); background: rgba(255, 254, 250, .96); backdrop-filter: blur(14px); }
    .nav { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .brand-mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 15px; background: var(--lime); font-size: 24px; }
    .brand-name { color: var(--green); font: 900 1.12rem/1 "Nunito", sans-serif; letter-spacing: -.04em; }
    .brand-name small { display: block; margin-top: 4px; color: var(--muted); font: 600 .65rem/1 "DM Sans", sans-serif; letter-spacing: .04em; }
    .nav-links { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 28px); }
    .nav-links a { color: #4c594f; font-size: .84rem; font-weight: 600; transition: color .15s ease; }
    .nav-links a:hover { color: var(--orange); }
    .nav-actions { display: flex; align-items: center; gap: 12px; }
    .cart-button { position: relative; display: inline-flex; min-height: 43px; align-items: center; gap: 8px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--green); font-weight: 700; cursor: pointer; }
    .cart-count { display: grid; min-width: 21px; height: 21px; place-items: center; padding-inline: 5px; border-radius: 50%; background: var(--orange); color: white; font-size: .7rem; }
    .menu-toggle { display: none; width: 43px; height: 43px; border: 1px solid var(--line); border-radius: 50%; background: white; color: var(--green); font-size: 1.2rem; cursor: pointer; }

    .hero { position: relative; overflow: hidden; padding: 68px 0 78px; background: var(--cream); }
    .hero::before, .hero::after { position: absolute; border-radius: 50%; content: ""; pointer-events: none; }
    .hero::before { top: -110px; right: -80px; width: 340px; height: 340px; background: rgba(246, 202, 82, .18); }
    .hero::after { bottom: -180px; left: 34%; width: 310px; height: 310px; background: rgba(121, 169, 75, .1); }
    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 54px; }
    .hero-copy { max-width: 550px; }
    .hero-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px; border: 1px solid #e6e9d8; border-radius: 999px; background: rgba(255,255,255,.75); color: var(--green); font-size: .76rem; font-weight: 700; }
    .hero h1 { margin: 19px 0 18px; color: var(--green-dark); font: 900 clamp(3rem, 6vw, 5rem)/.99 "Nunito", sans-serif; letter-spacing: -.065em; }
    .hero h1 em { color: var(--orange); font-style: normal; }
    .hero-copy > p { max-width: 480px; color: #6b756d; font-size: 1.03rem; line-height: 1.8; }
    .hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 25px; }
    .hero-meta { display: flex; align-items: center; gap: 13px; margin-top: 30px; color: var(--muted); font-size: .78rem; }
    .avatars { display: flex; padding-left: 5px; }
    .avatars span { display: grid; width: 31px; height: 31px; margin-left: -5px; place-items: center; border: 2px solid var(--cream); border-radius: 50%; background: #fbdcba; font-size: 15px; }
    .hero-visual { position: relative; min-height: 410px; }
    .hero-image { position: absolute; inset: 8px 24px 12px 0; overflow: hidden; border-radius: 47% 47% 27px 27px; background: #dde7c8; box-shadow: var(--shadow); }
    .hero-image img { width: 100%; height: 100%; object-fit: cover; }
    .hero-image::after { position: absolute; inset: 48% 0 0; background: linear-gradient(transparent, rgba(28, 54, 35, .39)); content: ""; }
    .image-caption { position: absolute; z-index: 1; right: 24px; bottom: 28px; left: 28px; color: white; }
    .image-caption strong { display: block; font: 800 1.3rem "Nunito", sans-serif; }
    .image-caption span { font-size: .79rem; opacity: .9; }
    .floating-price { position: absolute; z-index: 2; top: 45px; right: 0; padding: 13px 17px; transform: rotate(5deg); border: 4px solid white; border-radius: 18px; background: var(--yellow); color: var(--green-dark); box-shadow: var(--shadow); font: 900 1rem "Nunito", sans-serif; }
    .floating-price small { display: block; font: 700 .66rem "DM Sans", sans-serif; }
    .floating-fruit { position: absolute; z-index: 2; bottom: 38px; left: -21px; display: grid; width: 67px; height: 67px; place-items: center; border: 5px solid white; border-radius: 50%; background: var(--lime); box-shadow: var(--shadow); font-size: 32px; }

    .benefits { padding: 30px 0; border-bottom: 1px solid var(--line); background: white; }
    .benefit-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
    .benefit { display: flex; align-items: center; justify-content: center; gap: 11px; padding: 8px; }
    .benefit-icon { display: grid; width: 43px; height: 43px; flex: 0 0 auto; place-items: center; border-radius: 15px; background: var(--cream); font-size: 21px; }
    .benefit strong { display: block; color: var(--green-dark); font: 800 .85rem "Nunito", sans-serif; }
    .benefit small { display: block; margin-top: 3px; color: var(--muted); font-size: .7rem; }

    .shop-section { padding: 82px 0 88px; }
    .shop-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 25px; }
    .search-wrap { position: relative; width: min(350px, 100%); }
    .search-wrap span { position: absolute; top: 50%; left: 15px; transform: translateY(-50%); color: #8c958c; font-size: 1rem; pointer-events: none; }
    .search-wrap input { width: 100%; height: 47px; padding: 0 15px 0 43px; outline: none; border: 1px solid var(--line); border-radius: 999px; background: var(--cream); color: var(--ink); }
    .search-wrap input:focus { border-color: var(--green-bright); box-shadow: 0 0 0 3px rgba(121, 169, 75, .14); }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-chip { min-height: 38px; padding: 0 15px; border: 1px solid var(--line); border-radius: 999px; background: white; color: #647064; font-size: .78rem; font-weight: 700; cursor: pointer; transition: .15s ease; }
    .filter-chip:hover, .filter-chip.active { border-color: var(--green); background: var(--green); color: white; }
    .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .product-card { overflow: hidden; border: 1px solid #edf0e7; border-radius: 19px; background: white; transition: transform .2s ease, box-shadow .2s ease; }
    .product-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
    .product-image { position: relative; overflow: hidden; height: 185px; background: var(--cream); }
    .product-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
    .product-card:hover .product-image img { transform: scale(1.05); }
    .product-tag { position: absolute; top: 12px; left: 12px; padding: 6px 10px; border-radius: 999px; background: white; color: var(--green); font-size: .65rem; font-weight: 800; }
    .product-info { padding: 16px; }
    .product-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .product-title-row h3 { margin: 0; color: var(--green-dark); font: 800 1.04rem "Nunito", sans-serif; }
    .rating { color: #d99a22; font-size: .74rem; white-space: nowrap; }
    .product-info p { margin: 6px 0 14px; color: var(--muted); font-size: .74rem; }
    .product-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .price { color: var(--green); font: 900 1rem "Nunito", sans-serif; }
    .price small { color: var(--muted); font: 500 .69rem "DM Sans", sans-serif; }
    .add-btn { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border: 0; border-radius: 50%; background: var(--lime); color: var(--green); font-size: 1.2rem; font-weight: 700; cursor: pointer; transition: .15s ease; }
    .add-btn:hover { background: var(--green); color: white; transform: scale(1.06); }
    .empty-state { display: none; padding: 48px 15px; color: var(--muted); text-align: center; }
    .empty-state span { display: block; margin-bottom: 12px; font-size: 2.4rem; }

    .category-section { padding: 76px 0 83px; background: var(--cream); }
    .category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; }
    .category-card { position: relative; display: flex; min-height: 175px; overflow: hidden; align-items: flex-end; padding: 20px; border-radius: 19px; background: var(--lime); isolation: isolate; transition: transform .18s ease; }
    .category-card:hover { transform: translateY(-4px); }
    .category-card::after { position: absolute; z-index: -1; inset: 35% 0 0; background: linear-gradient(transparent, rgba(27, 49, 31, .75)); content: ""; }
    .category-card img { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .category-card span { color: white; font: 800 1.15rem "Nunito", sans-serif; }
    .category-card small { display: block; margin-top: 4px; color: rgba(255,255,255,.85); font: 500 .72rem "DM Sans", sans-serif; }

    .about-section { padding: 90px 0; }
    .about-grid { display: grid; grid-template-columns: .95fr 1.05fr; align-items: center; gap: 70px; }
    .about-photo { position: relative; min-height: 395px; }
    .about-photo img { width: 100%; height: 395px; object-fit: cover; border-radius: 25px; }
    .about-badge { position: absolute; right: -19px; bottom: 22px; display: grid; width: 106px; height: 106px; place-items: center; border: 6px solid white; border-radius: 50%; background: var(--yellow); color: var(--green-dark); text-align: center; font: 900 .85rem/1.1 "Nunito", sans-serif; transform: rotate(8deg); }
    .about-copy h2 { margin: 11px 0 16px; color: var(--green-dark); font: 900 clamp(2rem, 4vw, 3rem)/1.08 "Nunito", sans-serif; letter-spacing: -.045em; }
    .about-copy > p { color: var(--muted); line-height: 1.8; }
    .about-points { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 24px 0 27px; }
    .about-point { display: flex; gap: 10px; align-items: flex-start; color: var(--green); font-size: .8rem; font-weight: 700; }
    .about-point span:first-child { font-size: 1.15rem; }

    .offer-section { padding: 78px 0; background: var(--green); color: white; }
    .offer-inner { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 32px; }
    .offer-section .eyebrow { color: var(--yellow); }
    .offer-section h2 { max-width: 640px; margin: 10px 0; font: 900 clamp(2rem, 4vw, 3.2rem)/1.08 "Nunito", sans-serif; letter-spacing: -.04em; }
    .offer-section p { margin: 0; color: rgba(255,255,255,.75); line-height: 1.7; }
    .offer-code { min-width: 205px; padding: 19px 23px; transform: rotate(2deg); border: 2px dashed rgba(255,255,255,.53); border-radius: 18px; background: rgba(255,255,255,.09); text-align: center; }
    .offer-code small { display: block; color: var(--yellow); font-size: .68rem; font-weight: 800; letter-spacing: .13em; }
    .offer-code strong { display: block; margin: 5px 0; color: white; font: 900 1.65rem "Nunito", sans-serif; letter-spacing: .08em; }
    .offer-code span { color: rgba(255,255,255,.75); font-size: .7rem; }

    .contact-section { padding: 82px 0; background: #fff; }
    .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 55px; }
    .contact-copy h2 { margin: 10px 0 14px; color: var(--green-dark); font: 900 clamp(2rem, 4vw, 3rem)/1.08 "Nunito", sans-serif; letter-spacing: -.04em; }
    .contact-copy > p { color: var(--muted); line-height: 1.75; }
    .contact-list { display: grid; gap: 15px; margin-top: 28px; }
    .contact-item { display: flex; gap: 13px; align-items: flex-start; }
    .contact-icon { display: grid; width: 43px; height: 43px; flex: 0 0 auto; place-items: center; border-radius: 14px; background: var(--lime); font-size: 20px; }
    .contact-item strong { display: block; margin: 2px 0 4px; color: var(--green-dark); font: 800 .88rem "Nunito", sans-serif; }
    .contact-item span, .contact-item a { color: var(--muted); font-size: .78rem; line-height: 1.5; }
    .hours-card { padding: 26px; border: 1px solid var(--line); border-radius: 20px; background: var(--cream); }
    .hours-card h3 { margin: 0 0 5px; color: var(--green-dark); font: 900 1.25rem "Nunito", sans-serif; }
    .hours-card > p { margin: 0 0 19px; color: var(--muted); font-size: .78rem; }
    .hours-row { display: flex; justify-content: space-between; gap: 15px; padding: 14px 0; border-bottom: 1px solid #e5e9d9; font-size: .82rem; }
    .hours-row:last-of-type { border: 0; }
    .hours-row strong { color: var(--green); }
    .hours-note { margin-top: 18px; padding: 12px 14px; border-radius: 12px; background: white; color: var(--muted); font-size: .73rem; line-height: 1.5; }
    .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; margin-top: 18px; }
    .contact-form input, .contact-form textarea { width: 100%; min-height: 45px; padding: 12px 13px; outline: none; border: 1px solid var(--line); border-radius: 11px; background: white; color: var(--ink); font-size: .8rem; }
    .contact-form input:focus, .contact-form textarea:focus { border-color: var(--green-bright); }
    .contact-form textarea { grid-column: 1 / -1; min-height: 85px; resize: vertical; }
    .contact-form .btn { grid-column: 1 / -1; justify-self: start; }

    .footer { padding: 31px 0; background: #6b7b3a; color: rgba(255,255,255,.76); font-size: .75rem; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .footer .brand-name { color: white; }
    .footer .brand-name small { color: rgba(255,255,255,.63); }
    .footer-links { display: flex; flex-wrap: wrap; gap: 18px; }
    .footer-links a:hover { color: var(--yellow); }

    .overlay { position: fixed; z-index: 50; inset: 0; display: none; justify-content: flex-end; background: rgba(19, 34, 24, .45); }
    .overlay.open { display: flex; }
    .cart-panel { display: flex; width: min(430px, 100%); height: 100%; flex-direction: column; padding: 24px; background: var(--paper); box-shadow: -15px 0 50px rgba(0,0,0,.15); animation: slide-in .22s ease-out; }
    @keyframes slide-in { from { transform: translateX(25px); opacity: .6; } to { transform: translateX(0); opacity: 1; } }
    .panel-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 17px; border-bottom: 1px solid var(--line); }
    .panel-heading h2 { margin: 0; color: var(--green-dark); font: 900 1.5rem "Nunito", sans-serif; }
    .close-button { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: white; color: var(--green); font-size: 1.2rem; cursor: pointer; }
    .cart-items { flex: 1; overflow: auto; padding: 12px 0; }
    .cart-empty { padding: 55px 10px; color: var(--muted); text-align: center; }
    .cart-empty span { display: block; margin-bottom: 10px; font-size: 2.5rem; }
    .cart-line { display: grid; grid-template-columns: 63px 1fr auto; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--line); }
    .cart-line img { width: 63px; height: 63px; border-radius: 13px; object-fit: cover; }
    .cart-line strong { display: block; color: var(--green-dark); font: 800 .9rem "Nunito", sans-serif; }
    .cart-line small { display: block; margin-top: 4px; color: var(--muted); font-size: .72rem; }
    .quantity { display: flex; align-items: center; gap: 8px; margin-top: 7px; }
    .quantity button { display: grid; width: 23px; height: 23px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: white; color: var(--green); cursor: pointer; }
    .quantity span { font-size: .75rem; font-weight: 700; }
    .line-total { align-self: start; color: var(--green); font: 800 .82rem "Nunito", sans-serif; }
    .cart-summary { padding-top: 17px; border-top: 1px solid var(--line); }
    .summary-row { display: flex; justify-content: space-between; margin-bottom: 15px; color: var(--muted); font-size: .85rem; }
    .summary-row strong { color: var(--green-dark); font: 900 1.1rem "Nunito", sans-serif; }
    .cart-summary .btn { width: 100%; }
    .toast { position: fixed; z-index: 70; right: 20px; bottom: 20px; max-width: calc(100% - 40px); padding: 14px 19px; transform: translateY(15px); border-radius: 13px; background: var(--green-dark); color: white; box-shadow: var(--shadow); font-size: .85rem; opacity: 0; pointer-events: none; transition: .2s ease; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .checkout-modal { position: fixed; z-index: 60; inset: 0; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(19, 34, 24, .55); }
    .checkout-modal.open { display: flex; }
    .checkout-box { width: min(460px, 100%); max-height: 90vh; overflow: auto; padding: 25px; border-radius: 20px; background: var(--paper); box-shadow: var(--shadow); }
    .checkout-box h2 { margin: 0 0 6px; color: var(--green-dark); font: 900 1.55rem "Nunito", sans-serif; }
    .checkout-box > p { margin: 0 0 18px; color: var(--muted); font-size: .8rem; line-height: 1.55; }
    .checkout-form { display: grid; gap: 12px; }
    .checkout-form input, .checkout-form textarea { width: 100%; padding: 12px 13px; outline: none; border: 1px solid var(--line); border-radius: 11px; background: white; font-size: .84rem; }
    .checkout-form textarea { min-height: 75px; resize: vertical; }
    .checkout-actions { display: flex; gap: 9px; }
    .checkout-actions > * { flex: 1; }
    .confirmation { display: none; padding: 15px; border-radius: 13px; background: var(--lime); color: var(--green-dark); font-size: .84rem; line-height: 1.6; }
    .confirmation.show { display: block; }

    @media (max-width: 970px) {
      .nav-links { gap: 13px; }
      .nav-links a { font-size: .77rem; }
      .product-grid { grid-template-columns: repeat(3, 1fr); }
      .hero-grid { gap: 30px; }
      .about-grid { gap: 45px; }
    }
    @media (max-width: 760px) {
      .container { width: min(100% - 34px, 560px); }
      .topbar-inner { justify-content: center; min-height: 34px; font-size: .68rem; text-align: center; }
      .topbar-note { display: none; }
      .nav { min-height: 66px; }
      .nav-actions { margin-left: auto; }
      .menu-toggle { display: grid; }
      .nav-links { position: absolute; top: calc(100% + 1px); right: 0; left: 0; display: none; align-items: stretch; gap: 0; padding: 8px 22px 15px; border-bottom: 1px solid var(--line); background: var(--paper); box-shadow: 0 12px 20px rgba(37,51,42,.06); }
      .nav-links.open { display: flex; flex-direction: column; }
      .nav-links a { padding: 12px 2px; border-bottom: 1px solid var(--line); font-size: .9rem; }
      .nav-links a:last-child { border-bottom: 0; }
      .cart-button { min-height: 41px; padding: 0 10px; font-size: .8rem; }
      .hero { padding: 48px 0 53px; }
      .hero-grid { grid-template-columns: 1fr; gap: 28px; }
      .hero-copy { text-align: center; }
      .hero-copy > p { margin-inline: auto; }
      .hero-buttons, .hero-meta { justify-content: center; }
      .hero-visual { min-height: 340px; width: min(440px, 100%); margin: 0 auto; }
      .hero-image { inset: 4px 20px 10px 0; }
      .benefit-row { grid-template-columns: 1fr 1fr; gap: 10px 3px; }
      .benefit { justify-content: flex-start; }
      .shop-section, .contact-section { padding: 65px 0; }
      .section-heading { margin-bottom: 28px; }
      .shop-tools { align-items: stretch; }
      .search-wrap { width: 100%; }
      .filters { flex-wrap: nowrap; overflow-x: auto; padding: 2px 0 6px; }
